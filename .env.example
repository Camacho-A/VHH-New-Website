# Client ID for the site that's the source of truth for data (blog, products,
# contacts/CRM) — see README's "Wix Headless Integration" section. As of the site
# retirement, this is the same Wix-managed hosting project's own WIX_CLIENT_ID in
# .env.local (auto-generated by `headless link`). Kept as a separately named var rather
# than reading WIX_CLIENT_ID directly — Vite loads .env.local with higher precedence
# than .env, so this stays the one name our own code reads regardless of what's in
# .env.local at any given time.
WIX_DATA_CLIENT_ID=
PUBLIC_WIX_DATA_CLIENT_ID=
PUBLIC_WIX_CONTACT_FORM_ID=

# Wix Forms app form ID for the Shop page's Ultimate Hiring Bundle opt-in (First Name/
# Email). See src/lib/wixForms.ts.
PUBLIC_WIX_HIRING_BUNDLE_FORM_ID=

# Temporary webinar page (src/pages/webinar.astro) — remove after the Sept 2 event.
# Wix standalone form ID + the two Stripe Payment Links (early-bird / regular tier).
PUBLIC_WEBINAR_FORM_ID=
PUBLIC_WEBINAR_STRIPE_URL_EARLY=
PUBLIC_WEBINAR_STRIPE_URL_REGULAR=
