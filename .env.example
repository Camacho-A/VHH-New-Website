# Client ID for the EXISTING VHH Wix site — see README's "Wix Headless Integration"
# section. Not the same as the Wix-managed hosting project's own WIX_CLIENT_ID in
# .env.local (auto-generated by `headless link`, deliberately different name to avoid
# colliding with it).
WIX_DATA_CLIENT_ID=
PUBLIC_WIX_DATA_CLIENT_ID=
PUBLIC_WIX_CONTACT_FORM_ID=
