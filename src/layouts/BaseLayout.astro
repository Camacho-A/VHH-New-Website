---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  currentPage?: "home" | "about" | "services" | "business-consulting" | "workbook" | "blog";
  /** Defaults to the VHH logo mark. Pass a page-specific 1200x630 image once one exists —
   * no such asset exists yet, so every page currently shares this square logo as a
   * social-preview fallback rather than shipping with no og:image at all. */
  ogImage?: string;
}

const { title, description, currentPage = "home", ogImage = "/images/about-logo.png" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Organization schema uses only real, verifiable data (name, url, logo, social profiles).
// README also asks for LocalBusiness schema, which needs a real address/phone — neither
// exists anywhere in the design source or handoff README, and fabricating one would be
// actively harmful (misleading structured data). Add it once Danielle provides that.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The Virtual Helping Hand",
  url: "https://www.thevirtualhelpinghand.com",
  logo: new URL("/images/about-logo.png", Astro.site).toString(),
  description: "Strategy, systems, and support for entrepreneurs building stronger businesses.",
  sameAs: [
    "https://www.instagram.com/virtualhelpingh",
    "https://www.linkedin.com/company/the-virtual-helping-hand/",
    "https://www.facebook.com/profile.php?id=100091746784096",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header currentPage={currentPage} />
    <main id="main">
      <slot />
    </main>
    <Footer currentPage={currentPage} />
  </body>
</html>
