---
// Photo "plate": padding:6px; background:var(--bg-alt); outline:1px solid var(--rule)
// (README § Spacing & Shape). Renders a real photo when one exists in the design source
// (a few homepage image-slots already have a real Wix-hosted src); otherwise a labeled
// placeholder box marking what real photography goes there later (README § Notes:
// "Images marked image-slot are placeholders").

export interface Props {
  src?: string;
  alt?: string;
  label?: string;
  aspectRatio: string;
  /** Design applies a warm sepia/desaturate filter to real photos, not placeholder boxes. */
  filtered?: boolean;
  eager?: boolean;
  /** "cover" fills the plate (crops to the aspect ratio); "contain" shows the whole photo,
   * scaled to fit, letterboxed with the plate's own background. Default "cover" matches
   * the design's fixed aspect-ratio plates; use "contain" when a source photo's native
   * aspect ratio doesn't match the slot and cropping cuts off part of the subject. */
  fit?: "cover" | "contain";
  /** Skip the plate mat (padding/background/outline) entirely — the design source omits
   * it for one photo (About's "meet Danielle" portrait: "940px centered block, 360px
   * portrait, no border" per the handoff README), unlike every other image-slot. */
  bare?: boolean;
  /** Raw CSS `border` value applied directly to the image, independent of the plate's
   * own outline — e.g. a white frame around a photo sitting on a busy/dark background. */
  imgBorder?: string;
  /** Overrides the plate's mat background (default var(--bg-alt)) — e.g. the Shop page's
   * beige product cards swap the usual cream/mat pairing, so the mat needs to go cream
   * instead of the page's default beige-alt. Applied as a CSS custom property the plate's
   * own styles read, so it covers both the padding mat and the "contain" letterbox fill. */
  matColor?: string;
  /** CSS `object-position` for a "cover" crop — which part of the photo stays visible when
   * the source ratio doesn't match the slot. Default (unset) centers the crop; e.g.
   * "center 20%" keeps the top of a portrait in frame so a head isn't cut off. */
  objectPosition?: string;
}

const {
  src,
  alt = "",
  label,
  aspectRatio,
  filtered = true,
  eager = false,
  fit = "cover",
  bare = false,
  imgBorder,
  matColor,
  objectPosition,
} = Astro.props;

const imgStyle =
  [imgBorder ? `border:${imgBorder};` : "", objectPosition ? `object-position:${objectPosition};` : ""]
    .join("") || undefined;
const figureStyle = `aspect-ratio:${aspectRatio};${matColor ? ` --plate-mat-bg:${matColor};` : ""}`;
---

<figure class:list={["plate", { "plate--bare": bare }]} style={figureStyle}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        style={imgStyle}
        class:list={["plate__img", { "plate__img--filtered": filtered, "plate__img--contain": fit === "contain" }]}
        loading={eager ? "eager" : "lazy"}
      />
    ) : (
      <div class="plate__placeholder" role="img" aria-label={label}>
        <span>{label}</span>
      </div>
    )
  }
</figure>

<style>
  .plate {
    margin: 0;
    padding: 6px;
    background: var(--plate-mat-bg, var(--bg-alt));
    outline: 1px solid var(--rule);
    width: 100%;
  }

  .plate--bare {
    padding: 0;
    background: none;
    outline: none;
  }

  .plate__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate__img--contain {
    object-fit: contain;
    background: var(--plate-mat-bg, var(--bg-alt));
  }

  .plate__img--filtered {
    filter: sepia(0.22) saturate(0.82) contrast(1.05);
  }

  .plate__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: repeating-linear-gradient(
      135deg,
      rgba(43, 31, 22, 0.05),
      rgba(43, 31, 22, 0.05) 10px,
      transparent 10px,
      transparent 20px
    );
  }

  .plate__placeholder span {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
    padding: 16px;
    max-width: 220px;
  }
</style>
