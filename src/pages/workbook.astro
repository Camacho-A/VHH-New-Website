---
// Server-rendered per request (site-wide `output: 'server'`, no `prerender` override) —
// see astro.config.mjs / README § "Deployment routing": prerendered pages upload as static
// index.html and only match Wix's static-asset layer by exact literal path, so clean URLs
// like /workbook 404. SSR still returns full real HTML in the initial response, just
// generated at request time instead of pre-built at deploy time.

// Standalone opt-in page for "The Business Operations Glow-Up Workbook" — replaces the
// old Shop page's #hiring-bundle section now that the Shop (product catalog + cart) has
// been removed from the site entirely. Same underlying Wix Forms form and field targets
// as before (src/lib/wixHiringBundleForm.ts, PUBLIC_WIX_HIRING_BUNDLE_FORM_ID — the Wix
// dashboard form itself is still named "Ultimate Hiring Bundle"; only this site's display
// copy changed) — a dashboard automation on that form handles the PDF delivery and
// newsletter subscription, triggered by the submission landing; nothing else for the
// frontend to do.

import BaseLayout from "../layouts/BaseLayout.astro";

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";
---

<BaseLayout
  currentPage="workbook"
  title="Free Workbook | The Business Operations Glow-Up Workbook | The Virtual Helping Hand"
  description="Get The Business Operations Glow-Up Workbook, free — templates and guidance to streamline your day-to-day systems and reclaim your time."
>
  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <p class="kicker kicker--rule" style="margin-bottom:26px;">Free Guide</p>
    <h1 class="hero__title">The Business Operations Glow-Up Workbook</h1>
    <p class="hero__lede">
      A free, guided workbook to help you tighten up your day-to-day operations — clarify your systems, spot
      what's slowing you down, and walk away with a clear next step.
    </p>
  </section>

  <!-- ============ LEAD MAGNET ============ -->
  <section class="band lead-magnet">
    <div class="lead-magnet__grid">
      <div>
        <span class="chip lead-magnet__badge">Free Guide</span>
        <h2 class="lead-magnet__title">What's inside</h2>
        <p class="lead-magnet__desc">
          Practical exercises and templates to help you get a clearer picture of how your business actually
          runs day to day — and where to focus first.
        </p>
        <div class="lead-magnet__features">
          <p class="lead-magnet__feature">Operations self-assessment</p>
          <p class="lead-magnet__feature">Templates to map your systems</p>
          <p class="lead-magnet__feature">Sent straight to your inbox</p>
        </div>
      </div>

      <form class="lead-form" data-lead-form>
        <p class="lead-form__title">Get your free copy</p>
        <label class="lead-form__field">
          <span class="lead-form__label">First Name</span>
          <input type="text" name="firstName" data-lead-field="firstName" autocomplete="given-name" />
        </label>
        <label class="lead-form__field">
          <span class="lead-form__label">Email</span>
          <input type="email" name="email" data-lead-field="email" autocomplete="email" />
        </label>
        <p class="lead-form__error" data-lead-error hidden></p>
        <button type="submit" class="btn lead-form__submit" data-lead-submit>Send Me the Workbook</button>
        <p class="lead-form__consent">We'll also send occasional tips and updates. Unsubscribe any time.</p>
      </form>

      <div class="lead-success" data-lead-success hidden>
        <p class="lead-success__title">Check your inbox</p>
        <p class="lead-success__body">
          The Business Operations Glow-Up Workbook is on its way. If it hasn't arrived in a few minutes, check
          your promotions folder.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="contact" class="band final-cta">
    <h2 class="final-cta__title">need more than a workbook?</h2>
    <p class="final-cta__body">
      Are you ready to hit the ground running right now? Let's discuss how we can assist you and your business.
      Schedule your 30 minute consultation, for free!
    </p>
    <a href={CTA_HREF} class="btn btn--sm">Schedule Your FREE Consultation</a>
  </section>
</BaseLayout>

<script>
  import { submitHiringBundleForm } from "../lib/wixHiringBundleForm";

  // Same validate-on-submit + "Check your inbox" swap behavior the old Shop page's
  // #hiring-bundle section used (design doesn't spec validate-on-blur here, unlike the
  // About page contact form).
  const leadForm = document.querySelector<HTMLFormElement>("[data-lead-form]");
  const leadSuccess = document.querySelector<HTMLElement>("[data-lead-success]");
  const leadError = document.querySelector<HTMLElement>("[data-lead-error]");

  if (leadForm && leadSuccess) {
    const firstNameField = leadForm.querySelector<HTMLInputElement>('[data-lead-field="firstName"]');
    const emailField = leadForm.querySelector<HTMLInputElement>('[data-lead-field="email"]');
    const submitBtn = leadForm.querySelector<HTMLButtonElement>("[data-lead-submit]");

    const showLeadError = (message: string) => {
      if (!leadError) return;
      leadError.textContent = message;
      leadError.hidden = false;
    };

    leadForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (leadError) leadError.hidden = true;

      const firstName = firstNameField?.value.trim() ?? "";
      const email = emailField?.value.trim() ?? "";

      if (!firstName) return showLeadError("Please add your first name.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showLeadError("Please enter a valid email address.");

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      try {
        await submitHiringBundleForm(firstName, email);
        leadForm.hidden = true;
        leadSuccess.hidden = false;
      } catch (err) {
        console.error("Workbook lead submission failed:", err);
        showLeadError(
          "Something went wrong. Please email danielle@thevirtualhelpinghand.com and we'll get right back to you."
        );
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send Me the Workbook";
        }
      }
    });
  }
</script>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 90px) var(--section-pad-x) clamp(28px, 3vw, 40px);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 28px;
    max-width: 820px;
  }

  .hero__lede {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 640px;
    text-wrap: pretty;
  }

  /* ---- Lead magnet ---- */
  .band {
    border-top: 1px solid var(--rule);
    background: var(--bg-alt);
    padding: clamp(64px, 8vw, 110px) var(--section-pad-x);
  }

  .lead-magnet__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .lead-magnet__badge {
    margin-bottom: 18px;
  }

  .lead-magnet__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .lead-magnet__desc {
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--text-body);
    max-width: 480px;
    margin-bottom: 24px;
    text-wrap: pretty;
  }

  .lead-magnet__features {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .lead-magnet__feature {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-body);
    padding-left: 15px;
    border-left: 1px solid rgba(182, 130, 53, 0.5);
  }

  .lead-form,
  .lead-success {
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .lead-form {
    padding: clamp(24px, 3vw, 34px);
    flex-direction: column;
    gap: 18px;
  }

  /* Author CSS beats the UA default [hidden]{display:none} at equal specificity, so
     `.lead-form { display: flex }` would win and show the form even while hidden (same
     fix as Header.astro's .mobile-panel). Only switch to flex once the submit handler
     removes the hidden attribute on success. */
  .lead-form:not([hidden]) {
    display: flex;
  }

  .lead-form__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.3;
  }

  .lead-form__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .lead-form__label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-body);
  }

  .lead-form__field input {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text);
    background: transparent;
    border: 1px solid rgba(43, 31, 22, 0.28);
    border-radius: var(--radius-control);
    padding: 12px 13px;
  }

  .lead-form__field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .lead-form__error {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--accent-deep);
  }

  .lead-form__submit {
    width: 100%;
  }

  .lead-form__consent {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .lead-success {
    padding: clamp(28px, 3.5vw, 40px);
    text-align: center;
    border-color: var(--accent);
  }

  .lead-success__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    margin-bottom: 14px;
  }

  .lead-success__body {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-body);
  }

  /* ---- CTA ---- */
  .final-cta {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .final-cta__body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 600px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
</style>
