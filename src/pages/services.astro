    </div>
    <div class="concierge-strip">
      <div class="concierge-strip__copy">
        <div class="concierge-strip__badge-row">
          <span class="concierge-strip__badge">Subscription</span>
          <p class="concierge-strip__title">Content Concierge</p>
        </div>
        <p class="concierge-strip__desc">
          Rather we just create and you post? Receive 20 social media posts, captions, and hashtags each month.
        </p>
      </div>
      <a href="https://www.thevirtualhelpinghand.com/contentconcierge" class="btn btn--sm">Subscribe to Content Concierge</a>
    </div>
  </section>

  <!-- ============ BRANDING PACKAGES ============ -->
  <section id="branding" class="section">
    <h2 class="section-title2" style="margin-bottom:10px;">branding packages</h2>
