        </div>
      ))
    }
    <div class="no-results" data-no-results hidden>
      <p class="no-results__title">Nothing matched that search.</p>
      <p class="no-results__body">
        If you need something that isn't listed, ask. Much of what we do started as a custom request.
      </p>
      <a href={CTA_HREF} class="btn btn--sm">Ask About a Custom Service</a>
    </div>
  </section>

  <!-- ============ BUSINESS CONSULTING PACKAGES ============ -->
