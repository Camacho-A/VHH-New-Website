    <p class="kicker kicker--rule" style="margin-bottom:26px;">Services</p>
    <h1 class="hero__title">let's find exactly what your business needs.</h1>
    <p class="hero__lede">
      Every service we offer sits inside one of four pillars. Browse by what you're trying to solve, or search
      below if you already have something specific in mind.
    </p>
  </section>

  <!-- ============ FILTER ============ -->
  <section class="section section--tight">
    <div class="filter-box">
      <div class="filter-box__search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#b68235" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          type="text"
          data-search-input
          placeholder="Search a service, e.g. logo, calendar, website, invoicing"
          class="filter-box__input"
        />
        <button type="button" data-search-clear hidden class="filter-box__clear">Clear</button>
      </div>
      <div class="filter-box__chips">
        <span class="filter-box__chips-label">Filter</span>
        {
          FILTER_CHIPS.map((c) => (
            <button type="button" data-filter-chip={c.key} class:list={["chip-btn", { "is-active": c.key === "All" }]}>
              {c.label}
            </button>
          ))
        }
      </div>
      <p class="filter-box__result" data-result-line>Showing all {TOTAL_SERVICES} services across four pillars.</p>
    </div>
  </section>

  <!-- ============ SERVICE PILLARS ============ -->
  <section class="section">
    {
      PILLARS.map((p) => (
        <div id={`pillar-${p.key.toLowerCase()}`} class="pillar" data-pillar={p.key}>
          <button type="button" data-pillar-toggle aria-expanded="false" class="pillar__toggle">
            <span class="pillar__numeral">{p.numeral}</span>
            <h2 class="pillar__title">{p.title}</h2>
            <span class="pillar__count" data-pillar-count>
              {p.services.length} services
            </span>
            <span class="pillar__sign" data-pillar-sign aria-hidden="true">
              +
            </span>
          </button>
          <p class="pillar__problem">{p.problem}</p>
          <p class="pillar__promise">{p.promise}</p>
          <div class="pillar__services" data-pillar-services hidden>
            {p.services.map((s) => (
              <div class="service-row" data-service-name={s.name.toLowerCase()} data-service-desc={s.desc.toLowerCase()}>
