</BaseLayout>

<script>
  const pillars = Array.from(document.querySelectorAll<HTMLElement>("[data-pillar]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
  const clearBtn = document.querySelector<HTMLButtonElement>("[data-search-clear]");
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-chip]"));
  const resultLine = document.querySelector<HTMLElement>("[data-result-line]");
  const noResultsEl = document.querySelector<HTMLElement>("[data-no-results]");

  const TOTAL = document.querySelectorAll("[data-service-name]").length;
  let activePillarKey = "All";

  function applyFilters() {
    if (!searchInput) return;
    const q = searchInput.value.trim().toLowerCase();
    let totalVisible = 0;
    const forced = Boolean(q) || activePillarKey !== "All";

    pillars.forEach((pillarEl) => {
      const key = pillarEl.dataset.pillar!;
      const matchesPillarFilter = activePillarKey === "All" || activePillarKey === key;
      const rows = Array.from(pillarEl.querySelectorAll<HTMLElement>("[data-service-name]"));
      let visibleInPillar = 0;

      rows.forEach((row) => {
        const matchesQuery = !q || (row.dataset.serviceName ?? "").includes(q) || (row.dataset.serviceDesc ?? "").includes(q);
        const show = matchesPillarFilter && matchesQuery;
        row.hidden = !show;
        if (show) visibleInPillar += 1;
      });

      totalVisible += matchesPillarFilter ? visibleInPillar : 0;
      pillarEl.hidden = !(matchesPillarFilter && visibleInPillar > 0);

      const isOpen = forced || pillarEl.dataset.manuallyOpen === "true";
      const servicesEl = pillarEl.querySelector<HTMLElement>("[data-pillar-services]");
      const toggle = pillarEl.querySelector<HTMLButtonElement>("[data-pillar-toggle]");
      const sign = pillarEl.querySelector<HTMLElement>("[data-pillar-sign]");
      if (servicesEl) servicesEl.hidden = !isOpen;
      if (toggle) toggle.setAttribute("aria-expanded", String(isOpen));
      if (sign) sign.textContent = isOpen ? "−" : "+";

      const countLabel = pillarEl.querySelector<HTMLElement>("[data-pillar-count]");
      if (countLabel) countLabel.textContent = `${visibleInPillar} service${visibleInPillar === 1 ? "" : "s"}`;
    });

    if (noResultsEl) noResultsEl.hidden = totalVisible > 0;
    if (clearBtn) clearBtn.hidden = !q;

    if (resultLine) {
      const raw = searchInput.value.trim();
      if (q && totalVisible === 0) resultLine.textContent = `No services matched "${raw}".`;
      else if (q) resultLine.textContent = `Showing ${totalVisible} of ${TOTAL} services matching "${raw}".`;
      else if (activePillarKey !== "All") resultLine.textContent = `Showing ${totalVisible} services in this pillar.`;
      else resultLine.textContent = `Showing all ${TOTAL} services across four pillars.`;
    }
  }

  pillars.forEach((pillarEl) => {
    const toggle = pillarEl.querySelector<HTMLButtonElement>("[data-pillar-toggle]");
    toggle?.addEventListener("click", () => {
      const isManuallyOpen = pillarEl.dataset.manuallyOpen === "true";
      pillarEl.dataset.manuallyOpen = String(!isManuallyOpen);
      applyFilters();
    });
  });

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activePillarKey = chip.dataset.filterChip ?? "All";
      chips.forEach((c) => c.classList.toggle("is-active", c === chip));
      applyFilters();
    });
  });

  searchInput?.addEventListener("input", applyFilters);
  clearBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    applyFilters();
    searchInput?.focus();
  });

  // Deep link: /services#pillar-brand opens that pillar and scrolls to it, accounting
  // for the sticky header.
  function openFromHash() {
    const match = (window.location.hash || "").match(/^#pillar-(.+)$/);
    if (!match) return;
    const key = ["Consulting", "Brand", "Operations", "Support"].find((k) => k.toLowerCase() === match[1].toLowerCase());
    if (!key) return;
    const pillarEl = document.getElementById(`pillar-${key.toLowerCase()}`);
    if (!pillarEl) return;
    pillarEl.dataset.manuallyOpen = "true";
    applyFilters();
    requestAnimationFrame(() => {
      const y = pillarEl.getBoundingClientRect().top + window.scrollY - 96;
      window.scrollTo({ top: y });
    });
  }

  window.addEventListener("hashchange", openFromHash);
  openFromHash();
  applyFilters();
</script>

