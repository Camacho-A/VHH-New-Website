---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  currentPage="home"
  title="The Virtual Helping Hand | Business Growth Partner"
  description="Strategy, digital presence, systems, and ongoing support for entrepreneurs building stronger businesses."
>
  <section id="top" class="placeholder">
    <p>Homepage content — build order step 4.</p>
    <p>Shared shell (nav, footer, design tokens) is wired up; this page's real sections come next.</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
    font-size: 15px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 40vh;
  }
</style>
