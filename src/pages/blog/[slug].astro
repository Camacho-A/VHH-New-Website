---
// Server-rendered per request (site-wide `output: 'server'`, no `prerender` override) —
// see astro.config.mjs / README § "Deployment routing": prerendered pages upload as static
// index.html and only match Wix's static-asset layer by exact literal path, so clean URLs
// like /blog/some-slug 404. SSR still returns full real HTML in the initial response (nothing
// client-fetched) — it's generated at request time instead of pre-built at deploy time, which
// satisfies the same README § SEO crawlability concern this page originally used
// getStaticPaths for.
//
// Rebuilt against the new design_handoff_vhh_website/design-source/Blog Post.dc.html — no
// mockup existed for this page before now. Real rich-text body (heading / paragraph / bullet
// / pull-quote / table blocks), category + tags, and a "keep reading" related-posts section,
// wired to @wix/blog's richContent field via src/lib/richContent.ts (the design's own
// comment: "the rich-text body maps onto these block types").

import BaseLayout from "../../layouts/BaseLayout.astro";
import ImagePlate from "../../components/ImagePlate.astro";
import { getWixClient, getCategoryLabels, getTagLabels, wixImageUrl, formatPostDate } from "../../lib/wixClient";
import { parseRichContent, paragraphsToBlocks } from "../../lib/richContent";

const { slug } = Astro.params;
const wixClient = getWixClient();

let post: Awaited<ReturnType<typeof wixClient.posts.getPostBySlug>>["post"] | null = null;
try {
  ({ post } = await wixClient.posts.getPostBySlug(slug!, {
    fieldsets: ["RICH_CONTENT", "CONTENT_TEXT"],
  }));
} catch {
  post = null;
}

if (!post) {
  return Astro.redirect("/blog", 302);
}

const [categoryLabels, tagLabels, { items: allPosts }] = await Promise.all([
  getCategoryLabels(),
  getTagLabels(),
  wixClient.posts.queryPosts().descending("firstPublishedDate").find(),
]);

const category = categoryLabels.get(post.categoryIds?.[0] ?? "") ?? "";
const tags: string[] = (post.tagIds ?? [])
  .map((id: string) => tagLabels.get(id))
  .filter((t: string | undefined): t is string => Boolean(t));

const blocks = post.richContent?.nodes?.length ? parseRichContent(post.richContent) : paragraphsToBlocks(post.contentText);

const coverUrl = wixImageUrl(post.media?.wixMedia?.image);

const related = allPosts
  .filter((p: (typeof allPosts)[number]) => p.slug !== post!.slug)
  .slice(0, 3)
  .map((p: (typeof allPosts)[number]) => ({
    slug: p.slug,
    title: p.title,
    category: categoryLabels.get(p.categoryIds?.[0] ?? "") ?? "",
    meta: [formatPostDate(p.firstPublishedDate), p.minutesToRead ? `${p.minutesToRead} min read` : null]
      .filter(Boolean)
      .join(" · "),
  }));

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";
---

<BaseLayout
  currentPage="blog"
  title={`${post.title} | The Virtual Helping Hand Blog`}
  description={post.excerpt ?? post.title ?? ""}
  ogImage={coverUrl}
>
  <article class="post">
    <a href="/blog" class="post__back">&larr; Back to all posts</a>

    {category && <p class="post__category">{category}</p>}

    <h1 class="post__title">{post.title}</h1>

    <div class="post__meta-row">
      <p class="post__meta-item">The Virtual Helping Hand</p>
      <span class="post__dot" aria-hidden="true"></span>
      <p class="post__meta-item">{formatPostDate(post.firstPublishedDate)}</p>
      {post.minutesToRead && (
        <>
          <span class="post__dot" aria-hidden="true"></span>
          <p class="post__meta-item">{post.minutesToRead} min read</p>
        </>
      )}
    </div>

    {coverUrl && (
      <div class="post__cover">
        <ImagePlate src={coverUrl} alt={post.title ?? ""} aspectRatio="16/9" eager />
      </div>
    )}

    {post.excerpt && <p class="post__lede">{post.excerpt}</p>}

    <div class="post__body">
      {blocks.map((b) => {
        switch (b.kind) {
          case "heading":
            return <h2 class="post__heading">{b.text}</h2>;
          case "para":
            return <p class="post__para">{b.text}</p>;
          case "bullet":
            return <p class="post__bullet">{b.text}</p>;
          case "pull":
            return <p class="post__pull">{b.text}</p>;
          case "table":
            return (
              <div class="post__table-wrap">
                <table class="post__table">
                  {b.headers.length > 0 && (
                    <thead>
                      <tr>
                        {b.headers.map((h) => (
                          <th>{h}</th>
                        ))}
                      </tr>
                    </thead>
                  )}
                  <tbody>
                    {b.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          default:
            return null;
        }
      })}
    </div>

    {tags.length > 0 && (
      <div class="post__tags">
        <p class="post__tags-label">Filed under</p>
        {tags.map((t: string) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )}

    <!-- Static per design_handoff_vhh_website/design-source/Blog Post.dc.html — the mock
         hardcodes this author identity/bio for every post rather than pulling a per-post
         byline from Wix (the blog is single-author, under the brand account). -->
    <div class="post__author">
      <div class="post__author-photo">
        <ImagePlate src="/images/danielle-headshot.png" alt="Danielle McDougald" aspectRatio="1/1" />
      </div>
      <div>
        <p class="post__author-label">Written by</p>
        <h3 class="post__author-name">The Virtual Helping Hand</h3>
        <p class="post__author-bio">
          Founder of The Virtual Helping Hand. Navy spouse, mom of two, and a firm believer that a business
          should not depend on you remembering everything.
        </p>
      </div>
    </div>
  </article>

  <!-- ============ RELATED ============ -->
  {related.length > 0 && (
    <section class="band related">
      <h2 class="related__title">keep reading</h2>
      <div class="related__grid">
        {related.map((r: (typeof related)[number]) => (
          <a href={`/blog/${r.slug}`} class="related-card">
            {r.category && <p class="related-card__category">{r.category}</p>}
            <h3 class="related-card__title">{r.title}</h3>
            <p class="related-card__meta">{r.meta}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ CTA ============ -->
  <section class="band final-cta">
    <h2 class="final-cta__title">want this handled for you?</h2>
    <p class="final-cta__body">
      Are you ready to hit the ground running right now? Let's discuss how we can assist you and your business.
      Schedule your 30 minute consultation, for free!
    </p>
    <a href={CTA_HREF} class="btn btn--sm">Schedule Your FREE Consultation</a>
  </section>
</BaseLayout>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) var(--section-pad-x) clamp(48px, 6vw, 80px);
  }

  .post__back {
    display: inline-block;
    font-size: 13px;
    color: var(--accent-deep);
    margin-bottom: 28px;
  }

  .post__category {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 16px;
  }

  .post__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .post__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }

  .post__meta-item {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .post__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(43, 31, 22, 0.4);
  }

  .post__cover {
    margin-bottom: 40px;
  }

  .post__lede {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.55;
    margin-bottom: 40px;
    padding-left: 22px;
    border-left: 2px solid var(--accent);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    font-size: 17px;
    line-height: 1.85;
    color: var(--text-body);
  }

  .post__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 48px 0 18px;
  }

  .post__para {
    margin-bottom: 26px;
    text-wrap: pretty;
  }

  .post__bullet {
    margin-bottom: 14px;
    padding-left: 20px;
    border-left: 1px solid rgba(182, 130, 53, 0.5);
  }

  .post__pull {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.45;
    color: var(--text);
    text-align: center;
    margin: 44px 0;
  }

  .post__table-wrap {
    margin: 12px 0 34px;
    overflow-x: auto;
  }

  .post__table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    min-width: 520px;
  }

  .post__table th {
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    color: var(--accent-deep);
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid rgba(43, 31, 22, 0.3);
  }

  .post__table td {
    font-size: 15px;
    line-height: 1.6;
    padding: 14px 14px 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text-body);
  }

  .post__tags {
    border-top: 1px solid var(--rule);
    margin-top: 48px;
    padding-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .post__tags-label {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-right: 8px;
  }

  .post__author {
    margin-top: 44px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: clamp(22px, 3vw, 32px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
  }

  .post__author-photo {
    max-width: 150px;
    width: 100%;
  }

  .post__author-label {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 8px;
  }

  .post__author-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
    margin-bottom: 12px;
  }

  .post__author-bio {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-body);
  }

  /* ---- Related ---- */
  .band {
    border-top: 1px solid var(--rule);
    padding: clamp(48px, 6vw, 80px) var(--section-pad-x);
  }

  .related {
    background: var(--bg-alt);
  }

  .related > * {
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }

  .related__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    letter-spacing: -0.01em;
    margin-bottom: 32px;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .related-card {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text);
  }

  .related-card:hover {
    background: rgba(182, 130, 53, 0.09);
    color: var(--text);
  }

  .related-card__category {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .related-card__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
  }

  .related-card__meta {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  /* ---- CTA ---- */
  .final-cta {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 22px;
  }

  .final-cta__body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 580px;
    margin: 0 auto 34px;
    text-wrap: pretty;
  }
</style>
