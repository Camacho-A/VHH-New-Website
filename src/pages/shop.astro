---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  currentPage="shop"
  title="Shop | The Virtual Helping Hand"
  description="Templates and guides to help you hire, delegate, and grow — the Ultimate Hiring Bundle, Email Template Vault, and Content Vault."
>
  <section id="top" class="placeholder">
    <p>Shop page content — wired to @wix/stores in a later build step.</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
    font-size: 15px;
    color: var(--text-muted);
    min-height: 40vh;
  }
</style>
