---
// Wired to @wix/stores (build order step 6) — fetched at build time, same static-first
// approach as blog.astro. JSON-LD Product schema (README: "Keep the JSON-LD product
// schema on Shop — it's there so products can rank individually") is now built
// server-side from real data instead of injected by client JS.

import BaseLayout from "../layouts/BaseLayout.astro";
import ImagePlate from "../components/ImagePlate.astro";
import { getWixClient } from "../lib/wixClient";

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";

// Not a Wix Stores product — a free lead magnet that links out to its own opt-in page,
// same as the design source and README § Shop treat it.
const ULTIMATE_HIRING_BUNDLE = {
  anchor: "ultimate-hiring-bundle",
  kicker: "Free Resource",
  name: "The Ultimate Hiring Bundle",
  price: "Free",
  amount: null as number | null,
  cta: "Get Your Guide",
  desc: "Find the right support for your business. Templates and guidance for hiring your first, or next, virtual team member.",
  includes: ["Role and task templates", "Guidance on what to delegate first", "No cost"],
  href: "https://www.thevirtualhelpinghand.com/ultimatehiringbundle",
  image: undefined as string | undefined,
  imageLabel: "Guide cover mockup",
};

// "Includes" bullets and CTA copy are editorial, not exposed by the Stores API — kept as
// written for the redesign, keyed by the real product slug.
const PRODUCT_COPY: Record<string, { includes: string[]; cta: string }> = {
  "vhh-email-template-vault": {
    includes: ["Editable templates you can reuse", "Written in a warm, professional voice", "Instant download"],
    cta: "Buy the Email Template Vault",
  },
  "vhh-content-vault": {
    includes: ["Prompts you can post as written", "Built for service-based businesses", "Instant download"],
    cta: "Buy the Content Vault",
  },
};

const wixClient = getWixClient();
const { items } = await wixClient.products.queryProducts().find();

const stripHtml = (html: string | null | undefined) => (html ?? "").replace(/<[^>]+>/g, "").trim();

const realProducts = items
  .map((p) => {
    const copy = PRODUCT_COPY[p.slug ?? ""];
    return {
      anchor: p.slug ?? p._id!,
      kicker: "Digital Product",
      name: p.name ?? "",
      price: p.priceData?.formatted?.price ?? "",
      amount: p.priceData?.price ?? null,
      cta: copy?.cta ?? `Buy ${p.name}`,
      desc: stripHtml(p.description),
      includes: copy?.includes ?? [],
      href: p.productPageUrl ? `${p.productPageUrl.base}${p.productPageUrl.path}` : "#",
      image: p.media?.mainMedia?.image?.url,
      imageLabel: `${p.name} cover`,
    };
  })
  // Match the design's intended order (email vault, then content vault) regardless of
  // whatever order the API happens to return.
  .sort((a, b) => Object.keys(PRODUCT_COPY).indexOf(a.anchor) - Object.keys(PRODUCT_COPY).indexOf(b.anchor));

const PRODUCTS = [ULTIMATE_HIRING_BUNDLE, ...realProducts];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "The Virtual Helping Hand Shop",
  itemListElement: PRODUCTS.filter((p) => p.amount != null).map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.name,
      description: p.desc,
      url: p.href,
      brand: { "@type": "Brand", name: "The Virtual Helping Hand" },
      offers: {
        "@type": "Offer",
        price: p.amount,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: p.href,
      },
    },
  })),
};
---

<BaseLayout
  currentPage="shop"
  title="Shop | Templates & Tools | The Virtual Helping Hand"
  description="Enjoy easy editable business card templates, freebies, and more from The Virtual Helping Hand. Email templates, content vaults, and free hiring guides for small business owners."
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <p class="kicker kicker--rule" style="margin-bottom:26px;">Shop</p>
    <h1 class="hero__title">templates and tools you can use today.</h1>
    <p class="hero__lede">
      Enjoy easy editable business card templates, freebies, and more! Buy once, download instantly, and use
      them whenever you need them.
    </p>
  </section>

  <!-- ============ PRODUCTS ============ -->
  <section class="section">
    {
      PRODUCTS.map((p) => (
        <article id={p.anchor} class="product">
          <div class="product__photo">
            <ImagePlate src={p.image} alt={p.name} aspectRatio="4/5" label={p.imageLabel} />
          </div>
          <div>
            <p class="kicker" style="margin-bottom:12px;">
              {p.kicker}
            </p>
            <h2 class="product__name">{p.name}</h2>
            <p class="product__price">{p.price}</p>
            <p class="product__desc">{p.desc}</p>
            <div class="product__includes">
              {p.includes.map((f) => (
                <p class="product__include">{f}</p>
              ))}
            </div>
            <a href={p.href} class="btn btn--sm">
              {p.cta}
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ============ CTA ============ -->
  <section id="contact" class="band final-cta">
    <h2 class="final-cta__title">need more than a template?</h2>
    <p class="final-cta__body">
      Are you ready to hit the ground running right now? Let's discuss how we can assist you and your business.
      Schedule your 30 minute consultation, for free!
    </p>
    <a href={CTA_HREF} class="btn btn--sm">Schedule Your FREE Consultation</a>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 90px) var(--section-pad-x) clamp(32px, 4vw, 48px);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 28px;
  }

  .hero__lede {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 640px;
    text-wrap: pretty;
  }

  .section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--section-pad-x) clamp(48px, 6vw, 80px);
  }

  .product {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding: clamp(36px, 5vw, 56px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .product__photo {
    max-width: 420px;
    width: 100%;
  }

  .product__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .product__price {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 26px;
    margin-bottom: 20px;
  }

  .product__desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-body);
    max-width: 520px;
    margin-bottom: 22px;
    text-wrap: pretty;
  }

  .product__includes {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 28px;
  }

  .product__include {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-body);
    padding-left: 15px;
    border-left: 1px solid rgba(182, 130, 53, 0.5);
  }

  /* ---- CTA ---- */
  .band {
    border-top: 1px solid var(--rule);
    background: var(--bg-alt);
    padding: clamp(64px, 8vw, 110px) var(--section-pad-x);
  }

  .final-cta {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .final-cta__body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 600px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
</style>
