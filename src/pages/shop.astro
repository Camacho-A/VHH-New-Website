---
// Server-rendered per request (site-wide `output: 'server'`, no `prerender` override) —
// see astro.config.mjs / README § "Deployment routing": prerendered pages upload as static
// index.html and only match Wix's static-asset layer by exact literal path, so clean URLs
// like /shop 404. SSR still returns full real HTML in the initial response, just generated
// at request time instead of pre-built at deploy time.

// Rebuilt against the updated design_handoff_vhh_website/design-source/Shop.dc.html: a real
// storefront (category filter chips, cart drawer, Wix eCommerce checkout) instead of product
// rows linking out to the existing site's own product pages. Product data now comes from
// src/lib/wixProducts.ts (Catalog V3 — see that file for why, and why not the legacy V1
// `products` module previously used here). Cart/checkout is src/lib/wixCart.ts, rendered by
// the shared <CartDrawer /> component (also used by src/pages/shop/[slug].astro so both
// pages behave identically).
//
// Per README § "Lead magnet": the Ultimate Hiring Bundle is NOT a product — it's no longer
// in the grid or cart at all, replaced by an email opt-in section (#hiring-bundle). Submits
// to a real Wix Forms app form (src/lib/wixHiringBundleForm.ts, PUBLIC_WIX_HIRING_BUNDLE_FORM_ID) — a
// dashboard automation on that form handles the PDF delivery and newsletter subscription,
// triggered by the submission landing; nothing else for the frontend to do. Sending a free
// item through checkout was a $0 order that defeated the point (capturing the contact).
//
// Category chips and Add-to-Cart/qty/checkout are client-side (src/lib/wixCart.ts uses the
// browser-safe PUBLIC_WIX_DATA_CLIENT_ID, same as src/lib/wixForms.ts) — the cart is
// per-visitor and lives server-side on Wix, so it can't be read at request-render time the
// way products can. All products render server-side regardless of category so filtering is
// just a client-side show/hide, not a refetch: full product content stays in the page's
// initial HTML for crawlers even when a filter chip is later clicked.
//
// "Details" links to /shop/[slug] (this site's own product page) — never the old wix.com
// storefront.

import BaseLayout from "../layouts/BaseLayout.astro";
import ImagePlate from "../components/ImagePlate.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { getStoreProducts } from "../lib/wixProducts";

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";

const PRODUCTS = await getStoreProducts();

// Chips built from the products actually on the page ("All" + every distinct category
// present) rather than a hardcoded list — self-updating if a product's category changes.
const CATEGORIES = ["All", ...Array.from(new Set(PRODUCTS.map((p) => p.category)))];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "The Virtual Helping Hand Shop",
  itemListElement: PRODUCTS.filter((p) => p.amount != null).map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.name,
      description: p.desc,
      url: `/shop/${p.slug}`,
      brand: { "@type": "Brand", name: "The Virtual Helping Hand" },
      offers: {
        "@type": "Offer",
        price: p.amount,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: `/shop/${p.slug}`,
      },
    },
  })),
};
---

<BaseLayout
  currentPage="shop"
  title="Shop | Templates & Tools | The Virtual Helping Hand"
  description="Enjoy easy editable business card templates, freebies, and more from The Virtual Helping Hand. Email templates, content vaults, and free hiring guides for small business owners."
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <CartDrawer />

  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <p class="kicker kicker--rule" style="margin-bottom:26px;">Shop</p>
    <h1 class="hero__title">templates and tools you can use today.</h1>
    <p class="hero__lede">
      Enjoy easy editable business card templates, freebies, and more! Buy once, download instantly, and use
      them whenever you need them.
    </p>
  </section>

  <!-- ============ FILTER BAR ============ -->
  <section class="filter-section">
    <div class="filter-bar">
      <div class="filter-bar__chips" data-category-chips>
        {
          CATEGORIES.map((c, i) => (
            <button
              type="button"
              class="chip filter-chip"
              class:list={{ "filter-chip--active": i === 0 }}
              data-category-chip={c}
            >
              {c}
            </button>
          ))
        }
      </div>
      <p class="filter-bar__count" data-result-label>
        {PRODUCTS.length} {PRODUCTS.length === 1 ? "product" : "products"}
      </p>
    </div>
  </section>

  <!-- ============ PRODUCT GRID ============ -->
  <section class="section">
    <div class="product-grid">
      {
        PRODUCTS.map((p) => (
          <article id={p.slug} class="product-card" data-product-category={p.category}>
            <div class="product-card__photo-wrap">
              <ImagePlate src={p.image} alt={p.name} aspectRatio="4/3" label={p.imageLabel} fit="contain" matColor="var(--bg)" />
              {p.ribbon && <span class="product-card__ribbon">{p.ribbon}</span>}
            </div>
            <div class="product-card__body">
              <p class="kicker" style="margin-bottom:10px;">
                {p.category}
              </p>
              <h2 class="product-card__name">{p.name}</h2>
              <p class="product-card__desc">{p.desc}</p>
              <div class="product-card__price-row">
                <p class="product-card__price">{p.price}</p>
                {p.compareAtPrice && <p class="product-card__compare">{p.compareAtPrice}</p>}
              </div>
              <div class="product-card__actions">
                <button
                  type="button"
                  class="btn btn--sm product-card__cta"
                  data-add-to-cart
                  data-product-id={p.id}
                  data-product-name={p.name}
                >
                  Add to Cart
                </button>
                <a href={`/shop/${p.slug}`} class="product-card__details">
                  Details
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ LEAD MAGNET ============ -->
  <section id="hiring-bundle" class="band lead-magnet">
    <div class="lead-magnet__grid">
      <div>
        <span class="chip lead-magnet__badge">Free Guide</span>
        <h2 class="lead-magnet__title">The Ultimate Hiring Bundle</h2>
        <p class="lead-magnet__desc">
          Find the right support for your business. Templates and guidance for hiring your first, or next,
          virtual team member.
        </p>
        <div class="lead-magnet__features">
          <p class="lead-magnet__feature">Role and task templates</p>
          <p class="lead-magnet__feature">Guidance on what to delegate first</p>
          <p class="lead-magnet__feature">Sent straight to your inbox</p>
        </div>
      </div>

      <form class="lead-form" data-lead-form>
        <p class="lead-form__title">Get your free copy</p>
        <label class="lead-form__field">
          <span class="lead-form__label">First Name</span>
          <input type="text" name="firstName" data-lead-field="firstName" autocomplete="given-name" />
        </label>
        <label class="lead-form__field">
          <span class="lead-form__label">Email</span>
          <input type="email" name="email" data-lead-field="email" autocomplete="email" />
        </label>
        <p class="lead-form__error" data-lead-error hidden></p>
        <button type="submit" class="btn lead-form__submit" data-lead-submit>Send Me the Bundle</button>
        <p class="lead-form__consent">We'll also send occasional tips and updates. Unsubscribe any time.</p>
      </form>

      <div class="lead-success" data-lead-success hidden>
        <p class="lead-success__title">Check your inbox</p>
        <p class="lead-success__body">
          The Ultimate Hiring Bundle is on its way. If it hasn't arrived in a few minutes, check your
          promotions folder.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="contact" class="band final-cta">
    <h2 class="final-cta__title">need more than a template?</h2>
    <p class="final-cta__body">
      Are you ready to hit the ground running right now? Let's discuss how we can assist you and your business.
      Schedule your 30 minute consultation, for free!
    </p>
    <a href={CTA_HREF} class="btn btn--sm">Schedule Your FREE Consultation</a>
  </section>
</BaseLayout>

<script>
  import { submitHiringBundleForm } from "../lib/wixHiringBundleForm";

  // Category filter chips — pure client-side show/hide of the already-rendered grid
  // (see the frontmatter comment: every product's full content is in the initial HTML
  // regardless of category, so this never needs to refetch).
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-category-chip]");
  const cards = document.querySelectorAll<HTMLElement>("[data-product-category]");
  const resultLabel = document.querySelector<HTMLElement>("[data-result-label]");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const category = chip.dataset.categoryChip!;
      chips.forEach((c) => c.classList.toggle("filter-chip--active", c === chip));

      let visibleCount = 0;
      cards.forEach((card) => {
        const visible = category === "All" || card.dataset.productCategory === category;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      if (resultLabel) resultLabel.textContent = `${visibleCount} ${visibleCount === 1 ? "product" : "products"}`;
    });
  });

  // Lead magnet opt-in (README § "Lead magnet") — validate on submit (design doesn't spec
  // validate-on-blur here, unlike the About page contact form), then replace the form with
  // the "Check your inbox" panel on success, matching the design's state model exactly.
  const leadForm = document.querySelector<HTMLFormElement>("[data-lead-form]");
  const leadSuccess = document.querySelector<HTMLElement>("[data-lead-success]");
  const leadError = document.querySelector<HTMLElement>("[data-lead-error]");

  if (leadForm && leadSuccess) {
    const firstNameField = leadForm.querySelector<HTMLInputElement>('[data-lead-field="firstName"]');
    const emailField = leadForm.querySelector<HTMLInputElement>('[data-lead-field="email"]');
    const submitBtn = leadForm.querySelector<HTMLButtonElement>("[data-lead-submit]");

    const showLeadError = (message: string) => {
      if (!leadError) return;
      leadError.textContent = message;
      leadError.hidden = false;
    };

    leadForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (leadError) leadError.hidden = true;

      const firstName = firstNameField?.value.trim() ?? "";
      const email = emailField?.value.trim() ?? "";

      if (!firstName) return showLeadError("Please add your first name.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showLeadError("Please enter a valid email address.");

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      try {
        await submitHiringBundleForm(firstName, email);
        leadForm.hidden = true;
        leadSuccess.hidden = false;
      } catch (err) {
        console.error("Hiring bundle lead submission failed:", err);
        showLeadError("Something went wrong. Please email danielle@thevirtualhelpinghand.com and we'll get right back to you.");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send Me the Bundle";
        }
      }
    });
  }
</script>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 90px) var(--section-pad-x) clamp(28px, 3vw, 40px);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 28px;
    max-width: 820px;
  }

  .hero__lede {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 640px;
    text-wrap: pretty;
  }

  /* ---- Filter bar ---- */
  .filter-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 16px 0;
  }

  .filter-bar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-chip {
    cursor: pointer;
    background: transparent;
    font-family: var(--font-body);
  }

  .filter-chip--active {
    border-color: var(--accent);
    background: var(--accent-tint-strong);
    color: var(--accent-deep);
  }

  .filter-bar__count {
    font-size: 13.5px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Product grid ---- */
  .section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(32px, 4vw, 48px) var(--section-pad-x) clamp(56px, 7vw, 90px);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(24px, 3vw, 36px);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-alt);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .product-card[hidden] {
    display: none;
  }

  .product-card__photo-wrap {
    position: relative;
  }

  .product-card__ribbon {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent-deep);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: var(--radius-chip);
  }

  .product-card__body {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .product-card__desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-body);
    margin-bottom: 18px;
    flex: 1;
  }

  .product-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
  }

  .product-card__price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    font-variant-numeric: tabular-nums;
  }

  .product-card__compare {
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  .product-card__actions {
    display: flex;
    gap: 10px;
  }

  .product-card__cta {
    flex: 1;
  }

  .product-card__details {
    border: 1px solid rgba(43, 31, 22, 0.3);
    color: var(--accent-deep);
    padding: 12px 18px;
    border-radius: var(--radius-control);
    font-size: 14px;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .product-card__details:hover {
    background: var(--accent-tint);
    color: var(--accent-deep);
  }

  /* ---- Lead magnet ---- */
  .lead-magnet__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .lead-magnet__badge {
    margin-bottom: 18px;
  }

  .lead-magnet__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .lead-magnet__desc {
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--text-body);
    max-width: 480px;
    margin-bottom: 24px;
    text-wrap: pretty;
  }

  .lead-magnet__features {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .lead-magnet__feature {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-body);
    padding-left: 15px;
    border-left: 1px solid rgba(182, 130, 53, 0.5);
  }

  .lead-form,
  .lead-success {
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .lead-form {
    padding: clamp(24px, 3vw, 34px);
    flex-direction: column;
    gap: 18px;
  }

  /* Author CSS beats the UA default [hidden]{display:none} at equal specificity, so
     `.lead-form { display: flex }` would win and show the form even while hidden (same
     fix as Header.astro's .mobile-panel). Only switch to flex once the submit handler
     removes the hidden attribute on success. */
  .lead-form:not([hidden]) {
    display: flex;
  }

  .lead-form__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.3;
  }

  .lead-form__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .lead-form__label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-body);
  }

  .lead-form__field input {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text);
    background: transparent;
    border: 1px solid rgba(43, 31, 22, 0.28);
    border-radius: var(--radius-control);
    padding: 12px 13px;
  }

  .lead-form__field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .lead-form__error {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--accent-deep);
  }

  .lead-form__submit {
    width: 100%;
  }

  .lead-form__consent {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .lead-success {
    padding: clamp(28px, 3.5vw, 40px);
    text-align: center;
    border-color: var(--accent);
  }

  .lead-success__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    margin-bottom: 14px;
  }

  .lead-success__body {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-body);
  }

  /* ---- CTA ---- */
  .band {
    border-top: 1px solid var(--rule);
    background: var(--bg-alt);
    padding: clamp(64px, 8vw, 110px) var(--section-pad-x);
  }

  .final-cta {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .final-cta__body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 600px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
</style>
