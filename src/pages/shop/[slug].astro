---
// Product detail route — "Details" on the Shop listing links here instead of the old
// wix.com storefront, so a visitor never leaves this site to see a product.
//
// Server-rendered per request (site-wide `output: 'server'`, no `prerender` override),
// deliberately NOT statically pre-built despite that being the more literal reading of the
// brief — see astro.config.mjs / README § "Deployment routing" and src/pages/blog/[slug].astro
// for why every dynamic route on this site works this way: Wix hosting serves prerendered
// pages through a static-asset layer that only matches exact literal paths, so a prebuilt
// /shop/vhh-email-template-vault/index.html 404s on the clean URL. SSR still returns full
// real HTML in the initial response (nothing client-fetched) — generated per-request
// instead of at deploy time — which satisfies the same crawlability goal "statically
// generated" is really after, without the routing bug.
//
// Same editorial layout language as the blog post page (src/pages/blog/[slug].astro):
// back link, kicker, title, a plate-matted cover image, body copy, matching typography
// scale. Uses the same <CartDrawer /> component as the Shop listing so Add to Cart behaves
// identically in both places.

import BaseLayout from "../../layouts/BaseLayout.astro";
import ImagePlate from "../../components/ImagePlate.astro";
import CartDrawer from "../../components/CartDrawer.astro";
import { getStoreProductBySlug } from "../../lib/wixProducts";

const { slug } = Astro.params;
const product = slug ? await getStoreProductBySlug(slug) : null;

if (!product) {
  return Astro.redirect("/shop", 302);
}

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.desc,
  image: product.image,
  url: `/shop/${product.slug}`,
  brand: { "@type": "Brand", name: "The Virtual Helping Hand" },
  offers: product.amount != null && {
    "@type": "Offer",
    price: product.amount,
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `/shop/${product.slug}`,
  },
};
---

<BaseLayout
  currentPage="shop"
  title={`${product.name} | The Virtual Helping Hand Shop`}
  description={product.desc || product.name}
  ogImage={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <CartDrawer />

  <article class="product">
    <a href="/shop" class="product__back">&larr; Back to Shop</a>

    <p class="product__category">{product.category}</p>

    <h1 class="product__title">{product.name}</h1>

    <div class="product__cover">
      <ImagePlate src={product.image} alt={product.name} aspectRatio="4/3" label={product.imageLabel} fit="contain" eager />
      {product.ribbon && <span class="product__ribbon">{product.ribbon}</span>}
    </div>

    <div class="product__price-row">
      <p class="product__price">{product.price}</p>
      {product.compareAtPrice && <p class="product__compare">{product.compareAtPrice}</p>}
    </div>

    {product.desc && <p class="product__desc">{product.desc}</p>}

    <button type="button" class="btn product__cta" data-add-to-cart data-product-id={product.id} data-product-name={product.name}>
      Add to Cart
    </button>
  </article>

  <!-- ============ CTA ============ -->
  <section class="band final-cta">
    <h2 class="final-cta__title">need more than a template?</h2>
    <p class="final-cta__body">
      Are you ready to hit the ground running right now? Let's discuss how we can assist you and your business.
      Schedule your 30 minute consultation, for free!
    </p>
    <a href={CTA_HREF} class="btn btn--sm">Schedule Your FREE Consultation</a>
  </section>
</BaseLayout>

<style>
  .product {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) var(--section-pad-x) clamp(48px, 6vw, 80px);
  }

  .product__back {
    display: inline-block;
    font-size: 13px;
    color: var(--accent-deep);
    margin-bottom: 28px;
  }

  .product__category {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 16px;
  }

  .product__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.1rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 32px;
  }

  .product__cover {
    position: relative;
    margin-bottom: 32px;
  }

  .product__ribbon {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent-deep);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: var(--radius-chip);
  }

  .product__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 28px;
  }

  .product__price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 30px;
    font-variant-numeric: tabular-nums;
  }

  .product__compare {
    font-size: 16px;
    color: var(--text-muted);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  .product__desc {
    font-size: 17px;
    line-height: 1.85;
    color: var(--text-body);
    margin-bottom: 36px;
    text-wrap: pretty;
  }

  .product__cta {
    width: 100%;
  }

  /* ---- CTA ---- */
  .band {
    border-top: 1px solid var(--rule);
    background: var(--bg-alt);
    padding: clamp(64px, 8vw, 110px) var(--section-pad-x);
  }

  .final-cta {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .final-cta__body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 600px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
</style>
