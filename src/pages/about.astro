---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImagePlate from "../components/ImagePlate.astro";

const CTA_HREF = "https://calendly.com/thevirtualhelpinghand";

const CAPABILITIES = [
  { numeral: "I", title: "Strategic Thinking", desc: "We start with why, not what. The plan always comes before the task list." },
  { numeral: "II", title: "Operational Experience", desc: "Years inside real businesses, managing the backend that keeps them moving." },
  { numeral: "III", title: "Creative Execution", desc: "Branding, copy, and content that sound like you and resonate with your clients." },
  { numeral: "IV", title: "Digital Implementation", desc: "Websites, automations, and tools actually built and set up, not just recommended." },
  { numeral: "V", title: "Ongoing Support", desc: "We stay involved after launch, because a system nobody maintains stops being a system." },
];

const SOCIAL_LINKS = [
  {
    href: "https://www.instagram.com/virtualhelpingh",
    label: "Instagram",
    icon: '<rect width="20" height="20" x="2" y="2" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>',
  },
  {
    href: "https://www.linkedin.com/company/the-virtual-helping-hand/",
    label: "LinkedIn",
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>',
  },
  {
    href: "https://www.facebook.com/profile.php?id=100091746784096",
    label: "Facebook",
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>',
  },
];
---

<BaseLayout
  currentPage="about"
  title="About | The Virtual Helping Hand"
  description="Structure, clarity, and balance, brought to your business."
>
  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <p class="kicker kicker--rule" style="margin-bottom:26px;">About The Virtual Helping Hand</p>
    <h1 class="hero__title">Structure, clarity, and balance, brought to your business.</h1>
    <p class="hero__lede">
      The Virtual Helping Hand is a trusted partner for entrepreneurs and small businesses ready to bring
      structure, clarity, and balance to their operations. We specialize in streamlining day-to-day
      systems, managing backend processes, and creating workflows that support long-term growth.
    </p>
  </section>

  <!-- ============ ABOUT VHH ============ -->
  <section class="band origin">
    <div class="origin__grid">
      <div>
        <h2 class="section-title" style="margin-bottom:28px;">how it all started</h2>
        <p class="origin__body">
          Founded by Navy spouse and entrepreneur <strong>Danielle McDougald</strong>, The Virtual Helping
          Hand is powered by a team of dedicated Virtual Operations Specialists who go beyond
          administrative support. We become an extension of your business. From operations management and
          team coordination to process improvement and automation setup, we help simplify the moving parts
          so you can focus on what matters most.
        </p>
        <p class="origin__body">
          We are proudly powered by dependable and loyal military spouses and stay-at-home moms who bring
          structure, adaptability, and trust to every project.
        </p>
      </div>
      <ImagePlate label="VHH logo mark" aspectRatio="6/5" filtered={false} />
    </div>
  </section>

  <!-- ============ PHILOSOPHY ============ -->
  <section class="section">
    <h2 class="philosophy__title">we don't just complete tasks.<br />we help build better businesses.</h2>
    <p class="philosophy__lede">
      At The Virtual Helping Hand, we don't just manage tasks. We build systems that help your business
      thrive with efficiency and confidence. That takes five things working together.
    </p>
    <div class="capabilities">
      {
        CAPABILITIES.map((c) => (
          <div class="capabilities__cell">
            <p class="capabilities__numeral">{c.numeral}</p>
            <h3 class="capabilities__title">{c.title}</h3>
            <p class="capabilities__desc">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ MEET THE TEAM ============ -->
  <section class="band team">
    <div class="team__inner">
      <h2 class="section-title" style="margin-bottom:12px;">meet Danielle</h2>
      <p class="section-lede" style="margin-bottom:52px;">
        The founder behind the team that becomes an extension of your business.
      </p>
      <div class="team__grid">
        <ImagePlate label="Photo: Danielle McDougald" aspectRatio="784/1050" filtered={false} />
        <div>
          <p class="kicker" style="margin-bottom:10px;">CEO &amp; Founder</p>
          <h3 class="team__name">Danielle McDougald</h3>
          <a href="mailto:danielle@thevirtualhelpinghand.com" class="team__email">
            danielle@thevirtualhelpinghand.com
          </a>
          <p class="team__bio">
            As a Navy spouse, mom of two, and founder of The Virtual Helping Hand, Danielle is passionate
            about helping entrepreneurs find balance and structure in their growing businesses. With years
            of experience in virtual operations and executive support, she has built a reputation for
            turning chaos into clarity through streamlined systems, efficient workflows, and personalized
            strategies.
          </p>
          <p class="team__bio">
            Danielle understands the importance of flexibility and stability, both in life and in business.
            Her mission is to help entrepreneurs reclaim their time, operate with confidence, and scale with
            systems that truly work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GANDHI QUOTE ============ -->
  <section class="gandhi">
    <span class="gandhi__mark" aria-hidden="true">&ldquo;</span>
    <blockquote class="gandhi__quote">
      The best way to find yourself is to lose yourself in the service of others.
    </blockquote>
    <p class="gandhi__author">Mahatma Gandhi</p>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="band contact">
    <div class="contact__grid">
      <div>
        <h2 class="section-title" style="margin-bottom:20px;">contact now</h2>
        <p class="contact__lede">
          Are you ready to hit the ground running right now? Let's discuss how we can assist you and your
          business. Schedule your 30 minute consultation, for free.
        </p>
        <a href={CTA_HREF} class="btn" style="margin-bottom:34px;">Schedule Your FREE Consultation</a>
        <p class="kicker" style="margin-bottom:14px;">Follow Along</p>
        <div class="contact__socials">
          {
            SOCIAL_LINKS.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="contact__social">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <form class="contact-form" data-contact-form>
        <p class="contact-form__title">Send an Email</p>

        <p class="contact-form__error" data-form-error hidden>
          Something went wrong. Please email
          <a href="mailto:danielle@thevirtualhelpinghand.com">danielle@thevirtualhelpinghand.com</a>
          and we'll get right back to you.
        </p>

        <label class="contact-form__field">
          <span>Name</span>
          <input type="text" name="name" required data-field="name" />
          <span class="contact-form__field-error" data-field-error="name" hidden></span>
        </label>

        <label class="contact-form__field">
          <span>Email</span>
          <input type="email" name="email" required data-field="email" />
          <span class="contact-form__field-error" data-field-error="email" hidden></span>
        </label>

        <label class="contact-form__field">
          <span>How can we help?</span>
          <textarea name="message" rows="5" required data-field="message"></textarea>
          <span class="contact-form__field-error" data-field-error="message" hidden></span>
        </label>

        <button type="submit" class="btn" data-submit-btn>Submit</button>

        <p class="contact-form__success" data-form-success hidden>
          Thanks for reaching out — we'll be in touch soon.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Validate-on-blur + submit states per README § Contact form. Submission itself goes
  // through src/lib/wixForms.ts (@wix/forms) once PUBLIC_WIX_CONTACT_FORM_ID is set —
  // until then it falls back to a simulated delay so the visual states stay testable.
  import { submitContactForm, isContactFormConfigured } from "../lib/wixForms";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit-btn]");
    const errorBanner = form.querySelector<HTMLElement>("[data-form-error]");
    const successMsg = form.querySelector<HTMLElement>("[data-form-success]");
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-field]"));

    const messages: Record<string, string> = {
      name: "Please enter your name.",
      email: "Please enter a valid email address.",
      message: "Please tell us a bit about how we can help.",
    };

    const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const key = field.dataset.field!;
      const errorEl = form.querySelector<HTMLElement>(`[data-field-error="${key}"]`);
      const valid = field.checkValidity() && field.value.trim().length > 0;
      if (errorEl) errorEl.hidden = valid;
      if (errorEl && !valid) errorEl.textContent = messages[key] ?? "This field is required.";
      return valid;
    };

    fields.forEach((field) => {
      field.addEventListener("blur", () => validate(field));
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (errorBanner) errorBanner.hidden = true;

      const allValid = fields.map(validate).every(Boolean);
      if (!allValid) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      fields.forEach((f) => (f.disabled = true));

      try {
        if (isContactFormConfigured()) {
          const values = Object.fromEntries(fields.map((f) => [f.dataset.field, f.value]));
          await submitContactForm({
            name: values.name ?? "",
            email: values.email ?? "",
            message: values.message ?? "",
          });
        } else {
          // No live Wix form wired yet (PUBLIC_WIX_CONTACT_FORM_ID unset) — simulate so
          // the visual states stay testable in dev.
          console.warn("[contact form] PUBLIC_WIX_CONTACT_FORM_ID not set — simulating submit.");
          await new Promise((resolve) => setTimeout(resolve, 500));
        }

        if (submitBtn) submitBtn.textContent = "Thank You, We'll Be in Touch";
        if (successMsg) successMsg.hidden = false;
        // Submitted values stay visible per the design spec (not cleared on success).
      } catch (err) {
        console.error("Contact form submission failed:", err);
        if (errorBanner) errorBanner.hidden = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit";
        }
        fields.forEach((f) => (f.disabled = false));
      }
    });
  }
</script>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 90px) var(--section-pad-x) clamp(40px, 5vw, 64px);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 28px;
    max-width: 820px;
  }

  .hero__lede {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.75;
    color: rgba(43, 31, 22, 0.72);
    max-width: 640px;
    text-align: justify;
  }

  .section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
  }

  .band {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: var(--section-pad-y) var(--section-pad-x);
  }

  .origin {
    background: var(--bg-alt);
  }

  .origin__grid {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .origin__body {
    font-size: 16.5px;
    line-height: 1.8;
    color: var(--text-body);
    text-align: justify;
    margin-bottom: 22px;
  }

  .origin__body:last-child {
    margin-bottom: 0;
  }

  /* ---- Philosophy ---- */
  .philosophy__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 3.8vw, 3rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .philosophy__lede {
    max-width: 600px;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(43, 31, 22, 0.68);
    text-align: justify;
    margin-bottom: 48px;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .capabilities__cell {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 32px 24px;
  }

  .capabilities__numeral {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--accent-deep);
    letter-spacing: 0.05em;
    margin-bottom: 14px;
  }

  .capabilities__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    margin-bottom: 10px;
  }

  .capabilities__desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(43, 31, 22, 0.7);
  }

  /* ---- Team ---- */
  .team {
    background: var(--bg-alt);
  }

  .team__inner {
    max-width: 940px;
    margin: 0 auto;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(28px, 4vw, 48px);
    align-items: start;
  }

  .team__grid > :first-child {
    max-width: 360px;
    width: 100%;
  }

  .team__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.15;
    margin-bottom: 10px;
  }

  .team__email {
    font-size: 14px;
    color: var(--accent-deep);
    border-bottom: 1px solid rgba(182, 130, 53, 0.6);
    padding-bottom: 2px;
    display: inline-block;
    margin-bottom: 24px;
  }

  .team__bio {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-body);
    text-align: justify;
    margin-bottom: 20px;
  }

  .team__bio:last-child {
    margin-bottom: 0;
  }

  /* ---- Gandhi quote ---- */
  .gandhi {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
    text-align: center;
  }

  .gandhi__mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 80px;
    font-style: italic;
    color: var(--accent-deep);
    line-height: 0.6;
    margin-bottom: 14px;
  }

  .gandhi__quote {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(22px, 2.8vw, 32px);
    line-height: 1.45;
    color: var(--text);
  }

  .gandhi__author {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---- Contact ---- */
  .contact {
    background: var(--bg-alt);
  }

  .contact__grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .contact__lede {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(43, 31, 22, 0.72);
    text-align: justify;
    margin-bottom: 30px;
  }

  .contact__socials {
    display: flex;
    gap: 12px;
  }

  .contact__social {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(43, 31, 22, 0.3);
    border-radius: var(--radius-control);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-deep);
  }

  .contact__social:hover {
    background: var(--accent-tint-strong);
    border-color: var(--accent-deep);
  }

  .contact-form {
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: clamp(24px, 3vw, 36px);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-form__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .contact-form__field span:first-child {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(43, 31, 22, 0.65);
  }

  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text);
    background: transparent;
    border: 1px solid rgba(43, 31, 22, 0.28);
    border-radius: var(--radius-control);
    padding: 12px 13px;
  }

  .contact-form__field textarea {
    resize: vertical;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    border-color: var(--accent-deep);
  }

  .contact-form__field input:disabled,
  .contact-form__field textarea:disabled {
    opacity: 0.6;
  }

  .contact-form__field-error {
    font-size: 13px;
    color: var(--accent-deep);
  }

  .contact-form__error {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--accent-deep);
    background: rgba(182, 130, 53, 0.1);
    border-radius: var(--radius-control);
    padding: 12px 14px;
  }

  .contact-form__success {
    font-size: 13.5px;
    color: var(--text-muted);
  }
</style>
