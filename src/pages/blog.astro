---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  currentPage="blog"
  title="Blog | The Virtual Helping Hand"
  description="Insights on strategy, systems, and growth for entrepreneurs."
>
  <section id="top" class="placeholder">
    <p>Blog page content — wired to @wix/blog in a later build step.</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-pad-y) var(--section-pad-x);
    font-size: 15px;
    color: var(--text-muted);
    min-height: 40vh;
  }
</style>
